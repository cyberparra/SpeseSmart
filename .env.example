# Template pubblico: valori vuoti o fittizi, nessuna configurazione attiva.
# Non caricato da solo. lan:accounts vieta file .env nel repository.
# Pi legge MOUNT/data/production.env privato (0600), generato da pi:install.
SPESESMART_PI_CONFIG=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
# Esempi di limiti e tariffe: verificare sul proprio account prima dell'uso.
SPESESMART_AI_MONTHLY_USD=2
SPESESMART_AI_MAX_ANALYSES=100
SPESESMART_AI_TARIFF_JSON={"input":0.4,"cachedInput":0.1,"output":1.6}
# Percorsi assoluti privati esterni al repository, mai quelli di un altro utente.
SPESESMART_ACCOUNT_DIR=
SPESESMART_PREFERENCES_DIR=
SPESESMART_AI_DATA_DIR=
SPESESMART_SHEETS_UPDATE_DIR=
SPESESMART_LAN_DIR=
SPESESMART_ACCOUNT_BACKUP_PUBLIC_KEY_FILE=
SPESESMART_ACCOUNT_BACKUP_PRIVATE_KEY_FILE=
SPESESMART_BACKUP_ROOT=
SPESESMART_BACKUP_MOUNT=
SPESESMART_BACKUP_UUID=
SPESESMART_SHEETS_WRITES_ENABLED=false
SPESESMART_MULTIUSER=false
# TLS standalone/preview; production usa pi.json, vedi README §6.
SPESESMART_PI_TLS_DIR=
SPESESMART_PI_TLS_CA_SHA256=
# Opt-in remoto facoltativo, singolo FQDN della propria tailnet, default spento.
SPESESMART_PI_TAILSCALE_HOSTNAME=
# Profili legacy soltanto, non sostituiscono gli account multiutente.
SPESESMART_ACCESS_USER=
SPESESMART_ACCESS_PASSWORD=
