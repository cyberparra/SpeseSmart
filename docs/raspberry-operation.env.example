# Riferimento: generare i percorsi effettivi con npm run pi:install -- env.
# File privato MOUNT/data/production.env, 0600. Non eseguire con source.
# Nessun account predefinito; creare il proprio admin dopo pi:install -- init.
SPESESMART_MULTIUSER=true
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
SPESESMART_AI_MONTHLY_USD=2
SPESESMART_AI_MAX_ANALYSES=100
SPESESMART_AI_TARIFF_JSON={"input":0.4,"cachedInput":0.1,"output":1.6}
# Tariffe esemplificative da verificare prima di abilitare OpenAI.
# Tailscale facoltativo; hostname assente = adattatore spento.
# SPESESMART_PI_TAILSCALE_HOSTNAME=hostname-della-propria-tailnet.ts.net
